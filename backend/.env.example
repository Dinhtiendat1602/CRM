PORT=5001
NODE_ENV=development

# PostgreSQL Connection Pool
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zen_crm
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Authentication
JWT_SECRET=zen_crm_super_secret_jwt_key_2026_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# Nodemailer SMTP Configuration
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Zen CRM" <no-reply@zencrm.vn>

# Client URL (CORS)
FRONTEND_URL=http://localhost:5173
